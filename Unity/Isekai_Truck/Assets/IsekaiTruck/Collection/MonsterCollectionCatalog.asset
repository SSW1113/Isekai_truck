  entries:
  - monsterDefinition: {fileID: 2719208529127837379, guid: 566567d5ce7c39d46b871fa7082789bb, type: 3}
    portrait: {fileID: 2300000000000000001, guid: 85e12af4572541c08d3bba9ea0bb9652, type: 3}
    behaviorDescription: "\uADF8\uC800 \uB0A0\uC528\uAC00 \uC88B\uC544 \uC0B0\uCC45\uD558\uB7EC
      \uB098\uC628 \uD3C9\uBC94\uD55C \uC8FC\uBBFC\uC785\uB2C8\uB2E4."
    defeatDescription: "\uB3C4\uB9DD\uAC08 \uBC29\uD5A5\uC744 \uC608\uC0C1\uD574
      \uD2B8\uB7ED\uC73C\uB85C \uD55C \uBC88 \uC811\uCD09\uD558\uBA74 \uC774\uC138\uACC4
      \uC804\uC1A1\uC774 \uC644\uB8CC\uB429\uB2C8\uB2E4."
  - monsterDefinition: {fileID: 5516710088387759000, guid: e0fb4d2ea0e361a4cba96f6b20dd017b, type: 3}
    portrait: {fileID: 2300000000000000001, guid: a427c0b83d9b4a67b092362fb32c93a4, type: 3}
    behaviorDescription: "\uD56D\uC0C1 \uC77C\uC5D0 \uCE58\uC5EC \uC0AC\uB294 \uBD88\uC30D\uD55C
      \uC9C1\uC7A5\uC778\uC785\uB2C8\uB2E4."
    defeatDescription: "\uC774\uB3D9 \uACBD\uB85C\uB97C \uBBF8\uB9AC \uC608\uC0C1\uD558\uAC70\uB098,
      \uAC00\uC18D\uD55C \uC0C1\uD0DC\uB85C \uB530\uB77C\uAC00 \uC811\uCD09\uD558\uC138\uC694."
  - monsterDefinition: {fileID: 1950366111743342090, guid: 2eac7a28eded7d342bcdd235cb48d65b, type: 3}
    portrait: {fileID: 2300000000000000001, guid: b6d8fd2354f34d6eaba63b42fdf5189b, type: 3}
    behaviorDescription: "\uC624\uB79C\uB9CC\uC5D0 \uBC29\uAD6C\uC11D\uC744 \uBC97\uC5B4\uB098
      \uBB38\uBC16\uC744 \uB098\uC120 \uBB34\uC9C1\uBC31\uC218\uC785\uB2C8\uB2E4."
    defeatDescription: "\uD2B9\uBCC4\uD55C \uD68C\uD53C \uB2A5\uB825\uC740 \uC5C6\uC73C\uBBC0\uB85C
      \uD55C \uBC88 \uC811\uCD09\uD558\uBA74 \uC804\uC1A1\uB429\uB2C8\uB2E4. \uBCF4\uC0C1\uC774
      \uD070 \uB9CC\uD07C \uBCF4\uC774\uBA74 \uC6B0\uC120 \uCC3E\uC544\uBCF4\uC138\uC694."
  - monsterDefinition: {fileID: 6608619104608612596, guid: 12e278a8f98993346bfcf59c2ee85b70, type: 3}
    portrait: {fileID: 4362301577788073405, guid: 9e4733dad95cd574bb460b38d4286f38, type: 3}
    behaviorDescription: "\uADF8 \uBB34\uC5C7\uB3C4 \uB450\uB824\uC6CC\uD558\uC9C0
      \uC54A\uB294 \uC6A9\uB9F9\uD55C \uC804\uC0AC\uC785\uB2C8\uB2E4. \uC0AC\uC545\uD55C
      \uD2B8\uB7ED\uC744 \uBB3C\uB9AC\uCE58\uAE30 \uC704\uD574 \uB3CC\uC9C4\uD569\uB2C8\uB2E4."
    defeatDescription: "\uB2E4\uAC00\uC624\uB294 \uACBD\uB85C\uB97C \uC608\uC0C1\uD574
      \uC815\uBA74\uC5D0\uC11C \uC811\uCD09\uD558\uAC70\uB098, \uCE21\uBA74\uC73C\uB85C
      \uBE44\uCF1C \uC9C0\uB098\uAC04 \uB4A4 \uBC29\uD5A5\uC744 \uBC14\uAFD4 \uC811\uCD09\uD558\uC138\uC694."
  - monsterDefinition: {fileID: 1974516263114200338, guid: 398cce5610f62a04e88d57b5048c0561, type: 3}
    portrait: {fileID: -1180030930131768293, guid: 91ad820d3f264fe47b6f787b6971aa69, type: 3}
    behaviorDescription: "\uC219\uB828\uB41C \uB2CC\uC790\uB294 \uD1B5\uB098\uBB34
      \uBC14\uAFD4\uCE58\uAE30\uC220\uB85C \uC704\uAE30\uB97C \uD68C\uD53C\uD560
      \uC218 \uC788\uC9C0\uB9CC, \uC5EC\uB7EC \uBC88 \uC0AC\uC6A9\uD558\uC9C0\uB294
      \uBABB\uD558\uB294 \uBAA8\uC591\uC785\uB2C8\uB2E4."
    defeatDescription: "\uCCAB \uC811\uCD09\uC5D0\uC11C\uB294 \uBD84\uC2E0\uC220\uB9CC
      \uBC1C\uB3D9\uD569\uB2C8\uB2E4. \uC21C\uAC04\uC774\uB3D9\uD55C \uB2CC\uC790\uB97C
      \uB2E4\uC2DC \uB530\uB77C\uAC00 \uB450 \uBC88\uC9F8\uB85C \uC811\uCD09\uD558\uBA74
      \uC804\uC1A1\uB429\uB2C8\uB2E4."
  - monsterDefinition: {fileID: 663070851138419660, guid: 2f6c8b4dcdf41e54ca81d00c4a3e9bec, type: 3}
    portrait: {fileID: 5929303423528576716, guid: abc3934d5474bfd4cb8212a7e59068d1, type: 3}
    behaviorDescription: "\uC9C0\uB098\uAC00\uB294 \uACF3\uB9C8\uB2E4 \uC18D\uB3C4\uAC00
      \uB290\uB824\uC9C0\uB294 \uC548\uAC1C\uB97C \uAE54\uACE0 \uB2E4\uB2C8\uB294
      \uD55C\uB7C9\uD55C \uB3C4\uC0AC\uC785\uB2C8\uB2E4. \uC548\uAC1C\uB97C \uC870\uC2EC\uD558\uC138\uC694."
    defeatDescription: "\uC548\uAC1C \uC790\uAD6D\uC744 \uADF8\uB300\uB85C \uB530\uB77C\uAC00\uC9C0
      \uB9D0\uACE0 \uCE21\uBA74\uC5D0\uC11C \uC811\uADFC\uD574 \uC811\uCD09\uD558\uC138\uC694.
      \uAC10\uC18D \uC601\uC5ED\uC5D0\uC11C\uB294 \uBA3C\uC800 \uBE60\uC838\uB098\uC628
      \uB4A4 \uB2E4\uC2DC \uAC00\uC18D\uD558\uB294 \uAC83\uC774 \uC548\uC804\uD569\uB2C8\uB2E4."
  - monsterDefinition: {fileID: 7908487130593074500, guid: b5624ed01ecf05b4e9c1073defbf6482, type: 3}
    portrait: {fileID: -4405566701673946454, guid: 5e1ee32d69bd3f54fab711c486f45ca1, type: 3}
    behaviorDescription: "\uC624\uB298\uB3C4 \uB450\uAEBC\uC6B4 \uC804\uB2E8\uC9C0
      \uC138\uD2B8\uB97C \uB098\uB220\uC8FC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC804\uB2E8\uC9C0\uAC00
      \uB0A0\uC544\uAC00\uBC84\uB9B0\uB2E4\uBA74 \uD070\uC77C\uB098\uACA0\uB124\uC694."
    defeatDescription: "\uD55C \uBC88 \uC811\uCD09\uD558\uBA74 \uC804\uC1A1\uB429\uB2C8\uB2E4.
      \uC804\uC1A1 \uC9C1\uD6C4 \uD654\uBA74\uC774 \uAC00\uB824\uC9C8 \uC218 \uC788\uC73C\uBBC0\uB85C
      \uC7A5\uC560\uBB3C\uACFC \uB2E4\uB978 \uC8FC\uBBFC\uC774 \uC801\uC740 \uACF3\uC5D0\uC11C
      \uC811\uADFC\uD558\uC138\uC694."
  - monsterDefinition: {fileID: 134006205766120469, guid: 2f77c8f061232894a9e222d21d5c177e, type: 3}
    portrait: {fileID: -6980023475570107989, guid: b2f2c93bf782b1b48a62b999368fae86, type: 3}
    behaviorDescription: "\uC544\uD0AC\uB808\uC6B0\uC2A4\uB294 \uD3C9\uC0DD \uADF8
      \uAC70\uBD81\uC774\uB97C \uB530\uB77C\uC7A1\uC744 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
    defeatDescription: "\uD2B8\uB7ED \uD06C\uAE30\uB97C \uD0A4\uC6CC \uC811\uCD09
      \uBC94\uC704\uB97C \uB298\uB9AC\uAC70\uB098, \uBA48\uCDA4 \uD6A8\uACFC\uB85C
      \uAC70\uB9AC \uC720\uC9C0\uB97C \uC7A0\uC2DC \uB04A\uC740 \uB4A4 \uC811\uCD09\uD558\uC138\uC694."
  - monsterDefinition: {fileID: 3808845811863547839, guid: 743cecb6441b35a42a88a20fc85f81ee, type: 3}
    portrait: {fileID: -5336869132648099259, guid: ab26189061db47943ac4ad5c1c114d7a, type: 3}
    behaviorDescription: "\uD154\uB808\uD3EC\uD2B8 \uB9C8\uBC95\uC758 \uB2EC\uC778\uC774\uC9C0\uB9CC,
      \uBB34\uD55C\uD788 \uC0AC\uC6A9\uD560 \uC21C \uC5C6\uB294 \uBC95\uC774\uC8E0."
    defeatDescription: "\uC21C\uAC04\uC774\uB3D9 \uC9C1\uD6C4\uC758 \uC7AC\uC0AC\uC6A9
      \uB300\uAE30 \uC2DC\uAC04\uC5D0 \uBE60\uB974\uAC8C \uAC70\uB9AC\uB97C \uC881\uD788\uAC70\uB098,
      \uBA48\uCDA4 \uD6A8\uACFC\uB85C \uC21C\uAC04\uC774\uB3D9\uC744 \uB9C9\uACE0
      \uC811\uCD09\uD558\uC138\uC694."
