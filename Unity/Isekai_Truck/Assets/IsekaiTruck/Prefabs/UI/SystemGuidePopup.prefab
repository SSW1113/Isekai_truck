  pages:
  - category: "\uAE30\uBCF8 \uBAA9\uD45C\uC640 \uC131\uC7A5"
    title: "\uB2EC\uB9AC\uACE0, \uC804\uC1A1\uD558\uACE0, \uB354 \uAC15\uD574\uC9C0\uC138\uC694"
    summary: "\uD2B8\uB7ED\uC73C\uB85C \uB9F5\uC744 \uB204\uBE44\uBA70 \uC8FC\uBBFC\uC744
      \uC774\uC138\uACC4\uB85C \uC804\uC1A1\uD558\uACE0 EXP\uC640 \uC601\uD63C\uC744
      \uBAA8\uC73C\uB294 \uAC83\uC774 \uAE30\uBCF8 \uD750\uB984\uC785\uB2C8\uB2E4."
    tips:
    - title: "\uC8FC\uBBFC \uC804\uC1A1"
      body: "\uC8FC\uBBFC\uACFC \uD2B8\uB7ED\uC774 \uC811\uCD09\uD558\uBA74 \uC774\uC138\uACC4
        \uC804\uC1A1\uC774 \uC644\uB8CC\uB429\uB2C8\uB2E4. \uD68D\uB4DD\uD55C \uBCF4\uC0C1\uC740
        \uD2B8\uB7ED \uADFC\uCC98\uC5D0 \uD45C\uC2DC\uB429\uB2C8\uB2E4."
    - title: "\uB808\uBCA8 \uC5C5"
      body: "EXP\uAC00 \uCC28\uBA74 \uB808\uBCA8\uC774 \uC624\uB974\uACE0, \uB808\uBCA8\uB9C8\uB2E4
        \uD2B8\uB7ED\uC744 \uAC15\uD654\uD560 \uC5C5\uADF8\uB808\uC774\uB4DC \uD3EC\uC778\uD2B8\uB97C
        \uC5BB\uC2B5\uB2C8\uB2E4."
    - title: "\uC7A5\uAE30 \uC131\uC7A5"
      body: "\uC601\uD63C\uACFC \uD68D\uB4DD\uD55C \uCD95\uBCF5\uC740 \uC720\uC9C0\uB429\uB2C8\uB2E4.
        \uB3C4\uAC10\uC5D0\uC11C\uB294 \uC9C0\uAE08\uAE4C\uC9C0 \uC804\uC1A1\uD55C
        \uC8FC\uBBFC \uAE30\uB85D\uC744 \uBCFC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - category: "\uC870\uC791\uBC95"
    title: "\uD2B8\uB7ED\uC744 \uC6D0\uD558\uB294 \uBC29\uD5A5\uC73C\uB85C \uC774\uB044\uC138\uC694"
    summary: "\uD0A4\uBCF4\uB4DC\uC640 \uD654\uBA74 \uC870\uC774\uC2A4\uD2F1 \uC911
      \uD3B8\uD55C \uBC29\uC2DD\uC744 \uC0AC\uC6A9\uD558\uC138\uC694. \uC785\uB825\uD558\uB294
      \uB3D9\uC548 \uD2B8\uB7ED\uC740 \uC810\uC810 \uAC00\uC18D\uD569\uB2C8\uB2E4."
    tips:
    - title: "\uC774\uB3D9"
      body: "\uD0A4\uBCF4\uB4DC\uB294 W\xB7A\xB7S\xB7D\uB97C \uC0AC\uC6A9\uD569\uB2C8\uB2E4.
        \uD654\uBA74\uC5D0\uC11C\uB294 \uC911\uC559 \uAC8C\uC784 \uC601\uC5ED\uC744
        \uB204\uB978 \uCC44 \uC6D0\uD558\uB294 \uBC29\uD5A5\uC73C\uB85C \uB04C\uC5B4\uBCF4\uC138\uC694."
    - title: "\uAC00\uC18D\uACFC \uAD00\uC131"
      body: "\uC785\uB825\uC744 \uC720\uC9C0\uD558\uBA74 \uC18D\uB3C4\uAC00 \uC624\uB985\uB2C8\uB2E4.
        \uC190\uC744 \uB193\uC544\uB3C4 \uB9C8\uC9C0\uB9C9 \uC9C4\uD589 \uBC29\uD5A5\uC73C\uB85C
        \uC7A0\uC2DC \uAD00\uC131\uC774 \uB0A8\uC2B5\uB2C8\uB2E4."
    - title: "\uCD95\uBCF5 \uB2E8\uCD95\uD0A4"
      body: "\uC7A5\uCC29\uD55C \uC561\uD2F0\uBE0C \uCD95\uBCF5\uC740 \uC22B\uC790
        1\xB72\xB73\uC73C\uB85C \uC0AC\uC6A9\uD569\uB2C8\uB2E4. \uD328\uC2DC\uBE0C
        \uCD95\uBCF5\uC740 \uD56D\uC0C1 \uD6A8\uACFC\uB97C \uB0C5\uB2C8\uB2E4."
  - category: "\uD2B8\uB7ED \uC99D\uAC15"
    title: "\uC131\uC7A5 \uD3EC\uC778\uD2B8\uB97C \uC18D\uB3C4\uC640 \uD06C\uAE30\uC5D0
      \uD22C\uC790\uD558\uC138\uC694"
    summary: "\uC67C\uCABD \uD328\uB110\uC758 \uC5C5\uADF8\uB808\uC774\uB4DC \uBC84\uD2BC\uC5D0\uC11C
      \uD604\uC7AC \uD3EC\uC778\uD2B8\uB97C \uC6D0\uD558\uB294 \uB2A5\uB825\uCE58\uC5D0
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    tips:
    - title: "\uD3EC\uC778\uD2B8 \uD68D\uB4DD"
      body: "\uB808\uBCA8\uC774 \uD55C \uB2E8\uACC4 \uC624\uB97C \uB54C\uB9C8\uB2E4
        \uC5C5\uADF8\uB808\uC774\uB4DC \uD3EC\uC778\uD2B8\uB97C 1\uAC1C \uC5BB\uC2B5\uB2C8\uB2E4."
    - title: "\uC18D\uB3C4 \uC5C5\uADF8\uB808\uC774\uB4DC"
      body: "\uCD5C\uB300 \uC18D\uB3C4\uAC00 \uC62C\uB77C\uAC00 \uB354 \uBE60\uB974\uAC8C
        \uCD94\uACA9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC6B0\uCE21 \uD558\uB2E8
        \uC18D\uB3C4\uACC4\uB85C \uD604\uC7AC \uC18D\uB3C4\uB97C \uD655\uC778\uD558\uC138\uC694."
    - title: "\uD06C\uAE30 \uC5C5\uADF8\uB808\uC774\uB4DC"
      body: "\uD2B8\uB7ED\uC774 \uCEE4\uC9C0\uBA74 \uC2E4\uC81C \uC811\uCD09 \uBC94\uC704\uB3C4
        \uD568\uAED8 \uB113\uC5B4\uC9D1\uB2C8\uB2E4. \uCE74\uBA54\uB77C\uB294 \uCEE4\uC9C4
        \uD2B8\uB7ED\uC5D0 \uB9DE\uCDB0 \uC90C\uC544\uC6C3\uD569\uB2C8\uB2E4."
  - category: "\uC9C0\uBA85\uC218\uBC30 \uC2DC\uC2A4\uD15C"
    title: "\uB9CE\uC774 \uC804\uC1A1\uD560\uC218\uB85D \uCD94\uACA9\uC774 \uAC70\uC138\uC9D1\uB2C8\uB2E4"
    summary: "\uC8FC\uBBFC \uC804\uC1A1 \uD69F\uC218\uAC00 \uC313\uC774\uBA74 \uD654\uBA74
      \uC0C1\uB2E8\uC758 \uC9C0\uBA85\uC218\uBC30 \uBCC4\uC774 \uB298\uACE0, \uD2B8\uB7ED\uC744
      \uB4A4\uCAD3\uB294 \uCD94\uACA9\uC790\uB3C4 \uB9CE\uC544\uC9D1\uB2C8\uB2E4."
    tips:
    - title: "\uC218\uBC30 \uB2E8\uACC4"
      body: "\uC8FC\uBBFC 5\uBA85\uC744 \uC804\uC1A1\uD560 \uB54C\uB9C8\uB2E4 \uC9C0\uBA85\uC218\uBC30
        \uB808\uBCA8\uC774 1\uB2E8\uACC4 \uC624\uB974\uBA70, \uCD5C\uB300 10\uB2E8\uACC4\uAE4C\uC9C0
        \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
    - title: "\uCD94\uACA9\uC790 \uACBD\uACC4"
      body: "\uC218\uBC30 \uB808\uBCA8\uC774 \uB192\uC544\uC9C8\uC218\uB85D \uCD94\uACA9\uC790\uAC00
        \uB298\uC5B4\uB0A9\uB2C8\uB2E4. \uCCB4\uB825\uC774 \uBAA8\uB450 \uB5A8\uC5B4\uC9C0\uBA74
        \uD604\uC7AC EXP\uB97C \uC783\uACE0 \uB9AC\uC2A4\uD3F0\uD569\uB2C8\uB2E4."
    - title: "\uC138\uACC4 \uC774\uB3D9"
      body: "\uC9C0\uBA85\uC218\uBC30 Lv.5\uBD80\uD130 \uC6B0\uCE21 \uD328\uB110\uC758
        \uC138\uACC4 \uC774\uB3D9\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
        \uC774\uB3D9\uD558\uBA74 \uC218\uBC30 \uB2E8\uACC4\uAC00 \uCD08\uAE30\uD654\uB429\uB2C8\uB2E4."
  - category: "\uD658\uC0DD"
    title: "\uCC98\uC74C\uC73C\uB85C \uB3CC\uC544\uAC00 \uB354 \uD070 \uC131\uC7A5\uC744
      \uC900\uBE44\uD558\uC138\uC694"
    summary: "\uC694\uAD6C \uB808\uBCA8\uC5D0 \uB3C4\uB2EC\uD558\uBA74 \uD658\uC0DD\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD658\uC0DD\uC740 \uC77C\uBD80 \uC9C4\uD589\uB3C4\uB97C
      \uCD08\uAE30\uD654\uD558\uB294 \uB300\uC2E0 \uCD95\uBCF5\uACFC \uC7A5\uAE30
      \uBCF4\uB108\uC2A4\uB97C \uB0A8\uAE41\uB2C8\uB2E4."
    tips:
    - title: "\uD658\uC0DD \uC870\uAC74"
      body: "\uCCAB \uD658\uC0DD\uC740 Lv.10\uBD80\uD130 \uAC00\uB2A5\uD569\uB2C8\uB2E4.
        \uC131\uC7A5\uD560\uC218\uB85D \uB354 \uB192\uC740 \uD658\uC0DD \uB2E8\uACC4\uAC00
        \uCC28\uB840\uB85C \uC5F4\uB9BD\uB2C8\uB2E4."
    - title: "\uCD95\uBCF5 \uC120\uD0DD"
      body: "\uD658\uC0DD\uD560 \uB54C \uC81C\uC2DC\uB418\uB294 \uCD95\uBCF5 3\uAC1C
        \uC911 \uD558\uB098\uB97C \uC120\uD0DD\uD569\uB2C8\uB2E4. \uD68D\uB4DD\uD55C
        \uCD95\uBCF5\uC740 \uCD95\uBCF5 \uBA54\uB274\uC5D0\uC11C \uC7A5\uCC29\uD560
        \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - title: "\uB2E4\uC74C \uC131\uC7A5"
      body: "\uB808\uBCA8\uACFC \uD2B8\uB7ED \uC5C5\uADF8\uB808\uC774\uB4DC\uB294
        \uCD08\uAE30\uD654\uB418\uC9C0\uB9CC \uC601\uD63C\uACFC \uCD95\uBCF5\uC740
        \uC720\uC9C0\uB429\uB2C8\uB2E4. \uCD5C\uACE0 \uB2E8\uACC4 \uD658\uC0DD\uC740
        \uBCF4\uC0C1 \uBC30\uC728\uB3C4 \uB192\uC785\uB2C8\uB2E4."
  openDuration: 0.22
  pageTransitionDuration: 0.14
