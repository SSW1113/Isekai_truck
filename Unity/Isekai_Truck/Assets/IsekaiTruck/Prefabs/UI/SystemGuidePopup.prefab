  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IsekaiTruck.UI.SystemGuidePopup
  overlay: {fileID: 7319320220341310201}
  gameArea: {fileID: 4513767757171346794}
  panelRoot: {fileID: 7881156384068589861}
  overlayCanvasGroup: {fileID: 4238270457985864902}
  panelCanvasGroup: {fileID: 1235609705810399754}
